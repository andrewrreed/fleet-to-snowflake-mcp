# Copy to .env (gitignored) and fill in. Nothing here is secret, but it is environment-specific.
SNOWFLAKE_ACCOUNT=<org>-<account>            # org-account identifier, e.g. myorg-myaccount
SNOWFLAKE_USER=<snowflake_user>              # the user Fleet signs in as; gets FLEET_MCP_ROLE as default role
SNOWFLAKE_PRIVATE_KEY_PATH=~/.snowflake/fleet_mcp_rsa_key.p8
# LangSmith OAuth callback: https://<langsmith-host>/host-oauth-callback/<oauth-provider-id>
FLEET_OAUTH_REDIRECT_URI=https://smith.langchain.com/host-oauth-callback/<oauth-provider-id>
MCP_DATABASE=FLEET_MCP
MCP_SCHEMA=AGENTS
MCP_SERVER=FLEET_MCP_SERVER
